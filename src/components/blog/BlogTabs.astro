---
interface Props {
  activeTab: 'posts' | 'videos' | 'facebook'
}

const { activeTab } = Astro.props

const tabs = [
  { id: 'posts', label: '소식/공지', href: '/blog' },
  { id: 'videos', label: '영상', href: '/blog/videos' },
  { id: 'facebook', label: 'Facebook', href: '/blog/facebook' },
]
---

<div class="flex border-b border-gray-200 dark:border-gray-700 mb-8">
  {tabs.map((tab) => (
    <a
      href={tab.href}
      class:list={[
        'px-6 py-3 text-lg font-medium border-b-2 -mb-px transition-colors',
        activeTab === tab.id
          ? 'border-brand-600 text-brand-600 dark:text-brand-400 dark:border-brand-400'
          : 'border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300',
      ]}
    >
      {tab.label}
    </a>
  ))}
</div>
