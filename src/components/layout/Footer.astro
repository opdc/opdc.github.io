---
import { SITE } from '@/config'

const currentYear = new Date().getFullYear()
---

<footer class="bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800">
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- About -->
      <div>
        <h3 class="text-lg font-bold mb-4">{SITE.name}</h3>
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
          {SITE.description}
        </p>
        <p class="text-sm text-gray-600 dark:text-gray-400">
          Tel: {SITE.phone}
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-bold mb-4">빠른 링크</h3>
        <ul class="space-y-2">
          <li>
            <a href="/about" class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-500">
              소개
            </a>
          </li>
          <li>
            <a href="/history" class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-500">
              연혁
            </a>
          </li>
          <li>
            <a href="/blog" class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-500">
              소식/공지
            </a>
          </li>
          <li>
            <a href="/leaders" class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-500">
              리더
            </a>
          </li>
        </ul>
      </div>

      <!-- Community -->
      <div>
        <h3 class="text-lg font-bold mb-4">커뮤니티</h3>
        <ul class="space-y-2">
          <li>
            <a href="/projects" class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-500">
              프로젝트
            </a>
          </li>
          <li>
            <a href="/partners" class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-500">
              협력기관
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-800">
      <p class="text-center text-sm text-gray-600 dark:text-gray-400">
        © {currentYear} {SITE.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
