---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import LeadersCarousel from '@/components/LeadersCarousel'
import { SITE } from '@/config'

// Get latest blog posts (Korean only)
const allPosts = await getCollection('blog')
const posts = allPosts
  .filter(post => !post.data.draft && post.data.locale !== 'en')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

// Get latest videos (excluding playlists)
const allVideos = await getCollection('videos')
const videos = allVideos
  .filter(v => v.data.type !== 'playlist')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

// Combine and sort by date, take latest 6
type NewsItem = {
  type: 'post' | 'video'
  slug: string
  title: string
  date: Date
  description?: string
  tags?: string[]
  videoId?: string
  videoType?: 'video' | 'shorts' | 'playlist'
}

const combinedNews: NewsItem[] = [
  ...posts.map(p => ({
    type: 'post' as const,
    slug: p.slug,
    title: p.data.title,
    date: p.data.date,
    description: p.data.description,
    tags: p.data.tags,
  })),
  ...videos.map(v => ({
    type: 'video' as const,
    slug: v.slug,
    title: v.data.title,
    date: v.data.date,
    description: v.data.description,
    videoId: v.data.videoId,
    videoType: v.data.type,
  })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 6)

// Get all leaders and shuffle them
const allLeaders = await getCollection('leaders', ({ data }) => data.locale === 'ko')
// Fisher-Yates shuffle algorithm
const shuffleArray = <T,>(array: T[]): T[] => {
  const shuffled = [...array]
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]]
  }
  return shuffled
}
const shuffledLeaders = shuffleArray(allLeaders)

// Prepare leaders data for carousel
const leadersData = shuffledLeaders.map(leader => ({
  slug: leader.slug,
  name: leader.data.name,
  role: leader.data.role,
  image: leader.data.image || '',
}))
---

<BaseLayout>
  <!-- Main Image -->
  <section class="bg-white dark:bg-gray-900">
    <div class="container mx-auto px-4 pt-8">
      <img
        src="/img/about/opdc_img.png"
        alt="오픈플랫폼 개발자커뮤니티 소개 이미지"
        class="max-w-full h-auto rounded-lg mx-auto"
        loading="eager"
      />
    </div>
  </section>

  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-brand-50 to-blue-50 dark:from-gray-800 dark:to-gray-900 py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="sr-only">OPDC - 오픈플랫폼 개발자커뮤니티</h1>
        <blockquote class="text-xl md:text-2xl text-gray-700 dark:text-gray-300 mb-8 leading-relaxed">
          <p class="mb-4">
            (사)오픈플랫폼 개발자커뮤니티는 오픈플랫폼과 관련 서비스의 품질과 생산성을 높이고,<br class="hidden md:block"/>
            개발자들이 함께 배우고 성장할 수 있도록 다양한 교류와 지원을 이어가고 있습니다.<br class="hidden md:block"/>
            오픈소스 개발과 확산을 통해 더 열린 기술 생태계를 만들어가고자 합니다.
          </p>
          <p class="text-2xl md:text-3xl font-bold text-brand-600 dark:text-brand-500">
            개발자들이 함께 배우고 성장하는 열린 커뮤니티,<br />
            오픈플랫폼 개발자커뮤니티입니다.
          </p>
        </blockquote>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mt-12">
          <a
            href="/blog"
            class="px-8 py-4 bg-brand-700 text-white rounded-lg font-medium hover:bg-brand-800 transition-colors"
          >
            소식 보기
          </a>
          <a
            href="/about"
            class="px-8 py-4 border-2 border-brand-600 text-brand-600 dark:text-white dark:border-white rounded-lg font-medium hover:bg-brand-50 dark:hover:bg-brand-900/20 transition-colors"
          >
            더 알아보기
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest News -->
  <section class="py-16 bg-white dark:bg-gray-900">
    <div class="container mx-auto px-4">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-bold">최신 소식</h2>
        <a href="/blog" class="text-brand-700 hover:text-brand-800 font-medium">
          전체보기 →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {combinedNews.map((item) => (
          <article class="bg-gray-50 dark:bg-gray-800 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
            {item.type === 'video' ? (
              <!-- Video Item -->
              <a
                href={`https://www.youtube.com/watch?v=${item.videoId}`}
                target="_blank"
                rel="noopener noreferrer"
                class="block"
              >
                <div class="relative aspect-video bg-gray-200 dark:bg-gray-700">
                  <img
                    src={`https://img.youtube.com/vi/${item.videoId}/mqdefault.jpg`}
                    alt={item.title}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 flex items-center justify-center">
                    <div class="w-12 h-12 bg-red-600 rounded-full flex items-center justify-center shadow-lg">
                      <i class="fas fa-play text-white text-lg ml-1"></i>
                    </div>
                  </div>
                  <span class:list={[
                    'absolute top-2 left-2 text-xs px-2 py-1 rounded font-medium',
                    item.videoType === 'shorts'
                      ? 'bg-red-700 text-white'
                      : 'bg-blue-800 text-white'
                  ]}>
                    {item.videoType === 'shorts' ? 'Shorts' : '영상'}
                  </span>
                </div>
                <div class="p-4">
                  <time class="text-sm text-gray-500 dark:text-gray-400">
                    {item.date.toLocaleDateString('ko-KR', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </time>
                  <h3 class="text-lg font-bold mt-1 text-gray-900 dark:text-white line-clamp-2">
                    {item.title}
                  </h3>
                </div>
              </a>
            ) : (
              <!-- Blog Post Item -->
              <a href={`/blog/${item.slug}`} class="block p-6">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-xs px-2 py-1 bg-brand-100 dark:bg-brand-900/30 text-brand-800 dark:text-brand-300 rounded font-medium">
                    공지
                  </span>
                  <time class="text-sm text-gray-500 dark:text-gray-400">
                    {item.date.toLocaleDateString('ko-KR', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </time>
                </div>
                <h3 class="text-lg font-bold mt-2 mb-2 text-gray-900 dark:text-white line-clamp-2">
                  {item.title}
                </h3>
                {item.description && (
                  <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-2">
                    {item.description}
                  </p>
                )}
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Leaders Preview -->
  <section class="py-16 bg-gray-50 dark:bg-gray-800">
    <div class="container mx-auto px-4">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-bold">리더 소개</h2>
        <a href="/leaders" class="text-brand-700 hover:text-brand-800 font-medium">
          전체보기 →
        </a>
      </div>

      <LeadersCarousel client:load leaders={leadersData} />
    </div>
  </section>

  <!-- Contact & Social -->
  <section class="py-16 bg-white dark:bg-gray-900">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <!-- Social Icons -->
        <div class="flex flex-wrap justify-center gap-8 items-center" role="navigation" aria-label="소셜 미디어 링크">
          <a
            href="mailto:opdc.kr@gmail.com"
            title="이메일 문의"
            class="text-gray-700 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-500 transition-colors text-5xl"
            aria-label="이메일로 문의하기"
          >
            <i class="fas fa-envelope" aria-hidden="true"></i>
          </a>
          <a
            href="https://facebook.com/egovframe.open"
            title="Facebook 페이지 방문"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-700 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-500 transition-colors text-5xl"
            aria-label="페이스북 페이지 방문"
          >
            <i class="fab fa-facebook" aria-hidden="true"></i>
          </a>
          <a
            href="https://github.com/opdc"
            title="GitHub 저장소 방문"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-700 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-500 transition-colors text-5xl"
            aria-label="깃허브 저장소 방문"
          >
            <i class="fab fa-github" aria-hidden="true"></i>
          </a>
          <a
            href="https://youtube.com/@open-egovframe"
            title="YouTube 채널 방문"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-700 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-500 transition-colors text-5xl"
            aria-label="유튜브 채널 방문"
          >
            <i class="fab fa-youtube" aria-hidden="true"></i>
          </a>
          <a
            href="https://open.egovframe.org"
            title="오픈 커뮤니티 바로가기"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center transition-opacity hover:opacity-70"
            aria-label="오픈 커뮤니티 사이트 방문"
          >
            <img
              src="/img/opencommunity_logo_light.png"
              alt="오픈 커뮤니티 로고"
              class="w-12 h-12 object-contain dark:invert dark:opacity-85"
              loading="lazy"
            />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-brand-700 dark:bg-brand-800">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        함께 성장하는 개발자 커뮤니티
      </h2>
      <p class="text-xl text-brand-100 mb-8">
        오픈플랫폼 개발자들과 함께 배우고 나누세요
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/projects"
          class="px-8 py-4 bg-white text-brand-800 rounded-lg font-medium hover:bg-gray-100 transition-colors"
        >
          프로젝트 보기
        </a>
        <a
          href="/partners"
          class="px-8 py-4 border-2 border-white text-white rounded-lg font-medium hover:bg-brand-600 transition-colors"
        >
          협력기관 알아보기
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
