---
import { getCollection } from 'astro:content'
import RedesignLayout from '@/redesign/RedesignLayout.astro'
import '@/redesign/redesign.css'
import '@/redesign/people.css'
const leaders=(await getCollection('leaders',({data})=>data.locale==='ko')).sort((a,b)=>a.data.order-b.data.order)
---
<RedesignLayout title="People | OPDC Redesign" description="OPDC 커뮤니티 리더 소개">
  <section class="figma-section people-directory-page">
    <div class="redesign-container">
      <div class="people-directory-hero">
        <div>
          <p class="section-kicker">PEOPLE / {leaders.length}</p>
          <h1>함께 만들고<br/>함께 성장하는 사람들</h1>
          <p class="rd-lead">OPDC의 활동을 이어가는 커뮤니티 리더입니다. 각 프로필에서 활동과 경력을 확인할 수 있습니다.</p>
        </div>
        <div class="people-directory-count" aria-hidden="true"><strong>{leaders.length}</strong><span>COMMUNITY<br/>LEADERS</span></div>
      </div>
      <div class="people-directory-grid">
        {leaders.map(leader=><a class="people-directory-card" href={`/redesign/leaders/${leader.slug}/`}>
          <div class="people-directory-photo"><img src={leader.data.image} alt={`${leader.data.name} 프로필`} loading="lazy" decoding="async"/></div>
          <div class="people-directory-meta"><h2>{leader.data.name}</h2><p>{leader.data.role}</p><span>프로필 보기 →</span></div>
        </a>)}
      </div>
    </div>
  </section>
</RedesignLayout>

<style>
  .people-directory-page{overflow:hidden}
  .people-directory-hero{display:grid;grid-template-columns:minmax(0,1fr) 180px;gap:44px;align-items:end;margin-bottom:42px}
  .people-directory-hero h1{margin-bottom:24px}
  .people-directory-hero .rd-lead{margin-bottom:0}
  .people-directory-count{display:flex;align-items:flex-end;justify-content:flex-end;gap:12px;padding-bottom:8px;color:var(--muted)}
  .people-directory-count strong{font-size:54px;line-height:.9;color:var(--orange);letter-spacing:-.06em}
  .people-directory-count span{font-size:10px;line-height:1.25;font-weight:900;letter-spacing:.08em}
  .people-directory-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
  .people-directory-card{display:block;min-width:0;padding:12px 12px 16px;border:1px solid var(--line);border-radius:14px;background:#fff;text-decoration:none;transition:transform .2s,box-shadow .2s,border-color .2s}
  .people-directory-card:hover{transform:translateY(-3px);box-shadow:var(--shadow);border-color:#c8bfb2}
  .people-directory-photo{width:100%;aspect-ratio:4/5;overflow:hidden;border-radius:11px;background:#f1ede6}
  .people-directory-photo img{display:block!important;width:100%!important;height:100%!important;max-width:none!important;aspect-ratio:auto!important;object-fit:cover!important;object-position:center!important;border-radius:0!important;background:transparent!important}
  .people-directory-meta{padding:13px 4px 0}
  .people-directory-meta h2{margin:0 0 5px;font-size:18px;line-height:1.2;letter-spacing:-.025em}
  .people-directory-meta p{min-height:34px;margin:0;color:var(--muted);font-size:11px;line-height:1.45}
  .people-directory-meta span{display:block;margin-top:12px;color:var(--orange-dark);font-size:10px;font-weight:850}
  @media(max-width:1000px){.people-directory-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:720px){
    .people-directory-hero{grid-template-columns:1fr;gap:12px;margin-bottom:28px}
    .people-directory-count{justify-content:flex-start;padding:0}.people-directory-count strong{font-size:38px}
    .people-directory-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .people-directory-card{padding:8px 8px 12px;border-radius:12px}
    .people-directory-photo{aspect-ratio:4/5;border-radius:9px}
    .people-directory-meta{padding:10px 2px 0}
    .people-directory-meta h2{font-size:15px}.people-directory-meta p{min-height:29px;font-size:10px}.people-directory-meta span{margin-top:8px;font-size:9px}
  }
  @media(max-width:390px){.people-directory-grid{gap:8px}.people-directory-card{padding:7px 7px 10px}.people-directory-meta h2{font-size:14px}}
</style>