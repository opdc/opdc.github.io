---
import { getCollection } from 'astro:content'
import RedesignLayout from '@/redesign/RedesignLayout.astro'
import '@/redesign/redesign.css'
import '@/redesign/people.css'
const leaders=(await getCollection('leaders',({data})=>data.locale==='ko')).sort((a,b)=>a.data.order-b.data.order)
---
<RedesignLayout title="People | OPDC Redesign" description="OPDC 커뮤니티 리더 소개">
<section class="figma-section people-directory-page"><div class="redesign-container"><div class="people-directory-hero"><div><p class="section-kicker">PEOPLE / {leaders.length} LEADERS</p><h1>경험을 나누고<br/>다음 기여를 만듭니다</h1><p class="rd-lead">OPDC의 활동을 이어가는 커뮤니티 리더입니다. 각 프로필에서 역할과 경력, 커뮤니티 기록을 확인할 수 있습니다.</p></div><div class="people-directory-count" aria-hidden="true"><strong>{leaders.length}</strong><span>COMMUNITY<br/>LEADERS</span></div></div><div class="people-directory-grid">{leaders.map((leader,index)=><a class="people-directory-card" href={`/redesign/leaders/${leader.slug}/`}><div class="people-directory-photo"><img src={leader.data.image} alt={`${leader.data.name} 프로필`} loading={index<6?'eager':'lazy'} decoding="async"/></div><div class="people-directory-meta"><b>{String(index+1).padStart(2,'0')} · LEADER</b><h2>{leader.data.name}</h2><p>{leader.data.role}</p><span>프로필 보기 →</span></div></a>)}</div></div></section>
</RedesignLayout>
<style>
.people-directory-page{overflow:hidden}.people-directory-hero{display:grid;grid-template-columns:minmax(0,1fr) 180px;gap:52px;align-items:end;margin-bottom:48px}.people-directory-hero h1{margin:10px 0 24px;font-size:clamp(44px,6vw,76px);line-height:.96;letter-spacing:-.06em}.people-directory-hero .rd-lead{margin-bottom:0}.people-directory-count{display:flex;align-items:flex-end;justify-content:flex-end;gap:12px;padding-bottom:8px;color:var(--muted)}.people-directory-count strong{font-size:58px;line-height:.9;color:var(--orange);letter-spacing:-.06em}.people-directory-count span{font-size:10px;line-height:1.25;font-weight:900;letter-spacing:.08em}.people-directory-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.people-directory-card{display:block;min-width:0;padding:10px 10px 16px;border:1px solid var(--line);border-radius:16px;background:#fff;color:inherit;text-decoration:none;transition:transform .2s,box-shadow .2s,border-color .2s}.people-directory-card:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(23,25,28,.08);border-color:var(--orange)}.people-directory-photo{width:100%;aspect-ratio:4/5;overflow:hidden;border-radius:12px;background:var(--surface-soft)}.people-directory-photo img{display:block!important;width:100%!important;height:100%!important;max-width:none!important;object-fit:cover!important;object-position:center!important;border-radius:0!important}.people-directory-meta{padding:14px 4px 0}.people-directory-meta>b{display:block;margin-bottom:7px;color:var(--orange);font-size:8px;letter-spacing:.1em}.people-directory-meta h2{margin:0 0 5px;font-size:18px;line-height:1.2;letter-spacing:-.025em}.people-directory-meta p{min-height:34px;margin:0;color:var(--muted);font-size:11px;line-height:1.45}.people-directory-meta span{display:block;margin-top:12px;color:var(--ink);font-size:10px;font-weight:850}@media(max-width:1000px){.people-directory-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:720px){.people-directory-hero{grid-template-columns:1fr;gap:12px;margin-bottom:30px}.people-directory-count{justify-content:flex-start;padding:0}.people-directory-count strong{font-size:40px}.people-directory-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.people-directory-card{padding:7px 7px 12px;border-radius:13px}.people-directory-photo{border-radius:9px}.people-directory-meta{padding:10px 2px 0}.people-directory-meta h2{font-size:15px}.people-directory-meta p{min-height:29px;font-size:10px}.people-directory-meta span{margin-top:8px;font-size:9px}}@media(max-width:390px){.people-directory-grid{gap:8px}.people-directory-card{padding:6px 6px 10px}.people-directory-meta h2{font-size:14px}}
</style>