---
import { getCollection } from 'astro:content'
import RedesignLayout from '@/redesign/RedesignLayout.astro'
import '@/redesign/redesign.css'
export async function getStaticPaths(){const leaders=await getCollection('leaders',({data})=>data.locale==='ko');return leaders.map(leader=>({params:{slug:leader.slug},props:{leader}}))}
const {leader}=Astro.props
const {Content}=await leader.render()
---
<RedesignLayout title={`${leader.data.name} | OPDC`} description={`${leader.data.name} — ${leader.data.role}`} image={leader.data.image || '/img/about/opdc_img.webp'}>
  <section class="figma-section">
    <div class="redesign-container">
      <a class="rd-back" href="/redesign/leaders/">← PEOPLE</a>
      <div class="rd-profile">
        <img src={leader.data.image || '/img/about/opdc_img.webp'} alt={`${leader.data.name} 프로필 사진`}/>
        <div><p class="section-kicker">OPDC LEADER</p><h1>{leader.data.name}</h1><p class="rd-lead">{leader.data.role}</p><div class="rd-links">{leader.data.email&&<a href={`mailto:${leader.data.email}`}>Email</a>}{leader.data.github&&<a href={leader.data.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}{leader.data.linkedin&&<a href={leader.data.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>}</div></div>
      </div>
      <article class="rd-content"><Content/></article>
      <nav class="rd-detail-nav" aria-label="People 탐색"><a href="/redesign/leaders/">← 전체 People</a><a href="/redesign/community/">Community →</a></nav>
    </div>
  </section>
</RedesignLayout>