---
import RedesignLayout from '@/redesign/RedesignLayout.astro'
import { parse } from 'node-html-parser'
import '@/redesign/redesign.css'
import '@/redesign/section-v3.css'
async function fetchPosts(url:string,category:string){try{const response=await fetch(url);const root=parse(await response.text());return root.querySelectorAll('.board_list02 tr.body').slice(0,10).map(row=>{const cells=row.querySelectorAll('td');const link=row.querySelector('a.go');const href=(link?.getAttribute('href')||'').replace(/;jsessionid=[^?]*/,'');return {category,title:link?.textContent?.trim()||'',date:cells[3]?.textContent?.trim()||'',url:`https://open.egovframe.org${href}`}}).filter(x=>x.title)}catch{return []}}
const [notice,seminar,resources]=await Promise.all([fetchPosts('https://open.egovframe.org/oc/support/notice.do','공지사항'),fetchPosts('https://open.egovframe.org/oc/products/seminar.do','기술세미나'),fetchPosts('https://open.egovframe.org/oc/docs/pds.do','자료실')])
const groups=[['공지사항',notice,'notice','NOTICE'],['기술세미나',seminar,'seminar','SEMINAR'],['자료실',resources,'resources','RESOURCES']] as const
const total=notice.length+seminar.length+resources.length
---
<RedesignLayout title="Community | OPDC Redesign" description="OPDC 공지, 기술세미나, 자료실">
<section class="figma-section"><div class="redesign-container"><div class="rd-community-intro"><div><p class="section-kicker">COMMUNITY / LIVE</p><h1>정보를 모으고<br/>경험을 연결합니다</h1><p class="rd-lead">공지, 세미나와 기술 자료를 하나의 흐름으로 탐색합니다. 원문은 전자정부 표준프레임워크 오픈커뮤니티로 연결됩니다.</p></div><aside class="rd-community-note"><small>LIVE INDEX</small><strong>{total}개의 최신 항목</strong><p>공식 오픈커뮤니티의 최근 게시물을 빌드 시점에 수집해 카테고리별로 정리합니다.</p><div class="rd-community-stats"><span><b>{notice.length}</b> Notices</span><span><b>{seminar.length}</b> Seminars</span><span><b>{resources.length}</b> Resources</span></div></aside></div><nav class="rd-tags rd-community-tabs" aria-label="커뮤니티 섹션 바로가기">{groups.map(([title,,id,label])=><a href={`#${id}`}><small>{label}</small><span>{title}</span></a>)}</nav>{groups.map(([title,items,id,label])=><section class="rd-board" id={id}><h2><span>{label}</span>{title}<small>{items.length} items</small></h2><div class="rd-list">{items.length?items.map((item,index)=><a class="rd-list-item" href={item.url} target="_blank" rel="noreferrer"><div><span>{String(index+1).padStart(2,'0')} · {item.date||title}</span><h3>{item.title}</h3></div><b>↗</b></a>):<div class="rd-empty">현재 불러온 콘텐츠가 없습니다.</div>}</div></section>)}</div></section>
</RedesignLayout>