---
import RedesignLayout from '@/redesign/RedesignLayout.astro'
import '@/redesign/redesign.css'
import '@/redesign/section-v3.css'
const partners=[['우분투 코리아','/img/partners/logo_ubuntu_korea.webp','https://ubuntu-kr.org/','국내 개발자 커뮤니티 협력'],['OPA','/img/partners/logo_opa.webp','https://opakorea.org/','개방형 클라우드 플랫폼 생태계 조성'],['광주대학교','/img/partners/logo_gwangju.webp','https://www.gwangju.ac.kr/main','SW 중심대학 운영 협력'],['한국상용소프트웨어협회','/img/partners/logo_kosw.webp','https://www.kosw.or.kr/','상용 SW 호환성 확인 협력'],['KT','/img/partners/logo_kt.webp','https://kt.com/','클라우드 기술 협력'],['인프라닉스','/img/partners/logo_infranics.webp','https://www.infranics.com/','개방형 클라우드 플랫폼 확산 협력']]
---
<RedesignLayout title="Partners | OPDC Redesign" description="OPDC와 함께 오픈플랫폼 생태계를 만드는 협력 기관과 커뮤니티입니다."><section class="figma-section"><div class="redesign-container"><div class="rd-page-hero"><div><p class="section-kicker">PARTNERS</p><h1>함께 만드는 생태계</h1><p class="rd-lead">커뮤니티, 교육기관, 산업 파트너와 함께 기술 교류와 오픈플랫폼 확산을 이어갑니다.</p></div><aside class="rd-page-aside"><b>ECOSYSTEM</b><strong>{partners.length} Partners</strong><p>개발자 커뮤니티부터 교육기관, 산업 파트너까지 서로 다른 역할이 하나의 생태계를 만듭니다.</p></aside></div><div class="rd-partner-grid">{partners.map(([name,logo,url,desc])=><a class="rd-partner-card" href={url} target="_blank" rel="noreferrer"><div class="rd-partner-logo"><img src={logo} alt={`${name} 로고`}/></div><div><b class="section-kicker">PARTNER</b><h2>{name}</h2><p>{desc}</p></div></a>)}</div><section class="rd-section-band"><h2>협력의 방향</h2><p>단순한 로고 나열이 아니라 실제 기술 교류, 교육, 플랫폼 확산과 커뮤니티 연결을 만드는 협력을 지향합니다.</p><div class="rd-feature-grid"><div class="rd-feature"><b>COMMUNITY</b><strong>개발자 네트워크</strong><p>다른 커뮤니티와 지식을 공유하고 공동 활동의 접점을 만듭니다.</p></div><div class="rd-feature"><b>EDUCATION</b><strong>교육과 성장</strong><p>교육기관과 함께 기술 경험과 학습 기회를 확장합니다.</p></div><div class="rd-feature"><b>INDUSTRY</b><strong>현장과 연결</strong><p>산업 파트너와 오픈플랫폼 기술의 실제 활용을 넓혀갑니다.</p></div></div></section></div></section></RedesignLayout>