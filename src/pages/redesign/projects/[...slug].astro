---
import { getCollection } from 'astro:content'
import RedesignLayout from '@/redesign/RedesignLayout.astro'
import '@/redesign/redesign.css'
export async function getStaticPaths(){const projects=await getCollection('projects',({data})=>data.locale==='ko');return projects.map(project=>({params:{slug:project.slug},props:{project}}))}
const {project}=Astro.props
const {Content}=await project.render()
const statusLabel={active:'ACTIVE',completed:'COMPLETED',archived:'ARCHIVED'}[project.data.status]
---
<RedesignLayout title={`${project.data.title} | OPDC`} description={project.data.description} image={project.data.image || '/img/about/opdc_img.webp'}>
  <section class="figma-section">
    <div class="redesign-container">
      <a class="rd-back" href="/redesign/projects/">← PROJECTS</a>
      <div class="rd-detail-head">
        <div><p class="section-kicker">PROJECT DETAIL · {statusLabel}</p><h1>{project.data.title}</h1><p class="rd-lead">{project.data.description}</p></div>
        <a class="rd-detail-action" href="https://github.com/opdc" target="_blank" rel="noopener noreferrer">OPDC GitHub ↗</a>
      </div>
      <div class="rd-tags" aria-label="프로젝트 태그">{project.data.tags.map(tag=><span>{tag}</span>)}</div>
      {project.data.image&&<img class="rd-wide-image" src={project.data.image} alt={`${project.data.title} 프로젝트 화면`}/>} 
      <article class="rd-content"><Content/></article>
      <nav class="rd-detail-nav" aria-label="프로젝트 탐색"><a href="/redesign/projects/">← 전체 프로젝트</a><a href="/redesign/community/">Community →</a></nav>
    </div>
  </section>
</RedesignLayout>