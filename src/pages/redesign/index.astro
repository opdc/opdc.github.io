---
import RedesignLayout from '@/redesign/RedesignLayout.astro'
import '@/redesign/redesign.css'

const activities = [
  ['EVENT', '132차 세미나 · 컨트리뷰션 실전 & 시작하기', '2026.07.16', '/community/'],
  ['NEWS', 'AI를 활용한 표준프레임워크 컨트리뷰션', '2026.07.23', '/blog/'],
  ['VIDEO', '개발가이드 문서 기여로 시작하는 오픈소스', '2026.07.23', '/blog/'],
]

const projects = [
  ['K-PaaS', 'Local 설치를 위한 경량화 / Sandbox', 'Kubernetes · PaaS · Open Source', '/projects/'],
  ['eGovFrame', '전자정부 표준프레임워크 생태계와 호환성', 'Java · Spring · Compatibility', '/projects/'],
  ['Community OSS', '커뮤니티가 함께 만드는 공개 프로젝트', 'OSS · Contribution · Community', '/projects/'],
]
---

<RedesignLayout title="OPDC — Open Platform Developer Community">
  <section class="hero16">
    <div class="hero16-grid" aria-hidden="true"></div>
    <div class="redesign-container hero16-inner">
      <div class="hero16-copy">
        <p class="eyebrow">OPEN PLATFORM DEVELOPER COMMUNITY</p>
        <h1>OPEN<br /><span>PLATFORMS.</span><br />OPEN PEOPLE.<br /><span>OPEN FUTURE.</span></h1>
        <p class="hero16-lead">오픈플랫폼과 오픈소스를 중심으로 개발자와 프로젝트가 함께 배우고, 만들고, 연결되는 커뮤니티.</p>
        <div class="hero-actions"><a class="btn btn-primary" href="#projects">프로젝트 탐색</a><a class="btn btn-secondary" href="#community">커뮤니티 참여</a></div>
        <div class="hero-metrics"><div><strong>OSS</strong><span>Projects</span></div><div><strong>132+</strong><span>Seminars</span></div><div><strong>OPEN</strong><span>Community</span></div><div><strong>JOIN</strong><span>Contribute</span></div></div>
      </div>
      <div class="hero16-visual" aria-hidden="true">
        <svg viewBox="0 0 600 600" role="presentation">
          <g class="orbit orbit-outer"><circle cx="300" cy="300" r="230" /><circle cx="300" cy="300" r="175" /><circle cx="300" cy="300" r="110" /></g>
          <g class="network"><path d="M120 220L240 125L390 160L500 280L430 445L265 470L125 370Z" /><path d="M240 125L300 300L430 445M390 160L300 300L125 370M500 280L300 300L265 470" /></g>
          <g class="nodes"><circle cx="120" cy="220" r="10" /><circle cx="240" cy="125" r="10" /><circle cx="390" cy="160" r="10" /><circle cx="500" cy="280" r="10" /><circle cx="430" cy="445" r="10" /><circle cx="265" cy="470" r="10" /><circle cx="125" cy="370" r="10" /></g>
          <circle class="core" cx="300" cy="300" r="58" /><circle class="core-inner" cx="300" cy="300" r="28" />
        </svg>
        <div class="visual-label label-top">COMMUNITY SIGNAL</div><div class="visual-label label-bottom">BUILD · SHARE · CONNECT</div>
      </div>
    </div>
  </section>

  <section id="community" class="section section-muted">
    <div class="redesign-container">
      <div class="section-head"><div><p class="eyebrow">01 / COMMUNITY PULSE</p><h2>지금 커뮤니티에서 일어나는 일</h2></div><a class="text-link" href="/community/">전체 활동 보기 →</a></div>
      <div class="activity-grid">{activities.map(([type,title,date,href])=><a class="activity-card" href={href}><div class="card-meta"><span>{type}</span><time>{date}</time></div><h3>{title}</h3><span class="card-arrow">↗</span></a>)}</div>
    </div>
  </section>

  <section id="projects" class="section">
    <div class="redesign-container">
      <div class="section-head"><div><p class="eyebrow">02 / PROJECTS</p><h2>프로젝트를 발견하고 연결합니다</h2></div><a class="text-link" href="/projects/">프로젝트 전체 보기 →</a></div>
      <div class="project-grid">{projects.map(([name,title,tags,href],index)=><a class="project-card" href={href}><div class="project-number">0{index+1}</div><div class="project-content"><span class="project-name">{name}</span><h3>{title}</h3><p>{tags}</p><span class="card-arrow">↗</span></div></a>)}</div>
    </div>
  </section>

  <section id="knowledge" class="section dark-section">
    <div class="redesign-container knowledge-grid">
      <div><p class="eyebrow eyebrow-light">03 / WHY OPDC</p><h2>Open Platform.<br />Open Source.<br /><span>Open Community.</span></h2><p class="dark-copy">플랫폼을 쓰는 사람과 만드는 사람 사이를 연결하고, 경험과 지식을 다음 기여자에게 전달합니다.</p></div>
      <div class="principles"><article><b>01</b><h3>Open Platform</h3><p>기술과 생태계를 연결합니다.</p></article><article><b>02</b><h3>Open Source</h3><p>함께 만들고 다시 사용할 수 있게 합니다.</p></article><article><b>03</b><h3>Open Community</h3><p>사람과 지식을 다음 기여자로 연결합니다.</p></article></div>
    </div>
  </section>

  <section id="about" class="section">
    <div class="redesign-container">
      <div class="section-head"><div><p class="eyebrow">04 / KNOWLEDGE</p><h2>배우고, 공유하고, 다시 기여합니다</h2></div><a class="text-link" href="/blog/">지식 아카이브 →</a></div>
      <div class="knowledge-cards"><a href="/blog/" class="knowledge-card large"><span>ARTICLE</span><h3>기술 블로그와 커뮤니티 소식</h3><p>오픈소스, 클라우드, 표준프레임워크 등 현장의 경험을 모읍니다.</p></a><a href="/community/" class="knowledge-card"><span>EVENT</span><h3>세미나 & 밋업</h3><p>배우고 만나는 오픈플랫폼 기술 행사.</p></a><a href="/leaders/" class="knowledge-card"><span>PEOPLE</span><h3>리더 & 컨트리뷰터</h3><p>커뮤니티를 움직이는 사람들의 이야기.</p></a></div>
    </div>
  </section>

  <section class="join-section"><div class="redesign-container join-inner"><div><p class="eyebrow eyebrow-light">05 / JOIN OPDC</p><h2>다음 프로젝트의<br />첫 번째 기여자가 되어보세요.</h2></div><a class="btn btn-light" href="/community/">커뮤니티 참여 →</a></div></section>
</RedesignLayout>
