---
import BaseLayout from '@/layouts/BaseLayout.astro'

const partners = [
  {
    name: 'Ubuntu Korea',
    logo: '/img/partners/logo_ubuntu_korea.png',
    website: 'https://ubuntu-kr.org/',
    description: 'Developer Community Cooperation',
    mou: 'MOU 2023',
    activities: ['Ubuntu Korea 2024 Support', 'UbuCon Asia 2024 Sponsorship', 'LOUCA 2023 Sponsorship']
  },
  {
    name: 'OPA (Open cloud Platform Alliance)',
    logo: '/img/partners/logo_opa.png',
    website: 'https://opakorea.org/',
    description: 'Open Cloud Platform Ecosystem Development',
    mou: '',
    activities: ['Developer Community Division Operation', 'K-PaaS Competition Mentoring', 'K-PaaS Lightweight Project']
  },
  {
    name: 'Gwangju University',
    logo: '/img/partners/logo_gwangju.png',
    website: 'https://www.gwangju.ac.kr/main',
    description: 'SW-Centered University Cooperation',
    mou: 'MOU 2021',
    activities: []
  },
  {
    name: 'Korea Commercial Software Association',
    logo: '/img/partners/logo_kosw.png',
    website: 'https://www.kosw.or.kr/',
    description: 'Commercial SW Compatibility Verification',
    mou: '',
    activities: []
  },
  {
    name: 'KT',
    logo: '/img/partners/logo_kt.png',
    website: 'https://kt.com/',
    description: 'Cloud Technology Cooperation',
    mou: '',
    activities: []
  },
  {
    name: 'Infranics',
    logo: '/img/partners/logo_infranics.png',
    website: 'https://www.infranics.com/',
    description: 'Open Cloud Platform Expansion',
    mou: 'MOU 2020',
    activities: []
  },
]
---

<BaseLayout title="Partners" description="MOU Partner Organizations and Companies">
  <div class="bg-gradient-to-br from-brand-50 to-blue-50 dark:from-gray-800 dark:to-gray-900 py-12">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Partners</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        MOU Partner Organizations and Companies
      </p>
    </div>
  </div>

  <div class="container mx-auto px-4 py-16">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {partners.map((partner) => (
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-lg transition-shadow p-6">
            <a
              href={partner.website}
              target="_blank"
              rel="noopener noreferrer"
              class="group block"
            >
              <div class="mb-4 flex items-center justify-center h-24">
                <img
                  src={partner.logo}
                  alt={`${partner.name} Logo`}
                  class="max-h-full w-auto object-contain transition-transform group-hover:scale-105"
                />
              </div>
              <h3 class="font-bold text-gray-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-500 transition-colors text-center mb-2">
                {partner.name}
              </h3>
            </a>
            <p class="text-base text-gray-600 dark:text-gray-400 text-center mb-2">
              {partner.description}
            </p>
            {partner.mou && (
              <p class="text-sm text-brand-600 dark:text-brand-400 text-center mb-4">
                {partner.mou}
              </p>
            )}
            {partner.activities && partner.activities.length > 0 && (
              <ul class="text-sm text-gray-600 dark:text-gray-400 space-y-2">
                {partner.activities.map((activity: string) => (
                  <li class="flex items-start gap-2">
                    <span class="text-brand-600">•</span>
                    <span>{activity}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
