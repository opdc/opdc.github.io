---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { SITE } from '@/config'
---

<BaseLayout title="About" description="About Open Platform Developer Community (OPDC)">
  <div class="bg-gradient-to-br from-brand-50 to-blue-50 dark:from-gray-800 dark:to-gray-900 py-12">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">About</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        About Open Platform Developer Community (OPDC)
      </p>
    </div>
  </div>

  <div class="container mx-auto px-4 py-16">
    <div class="max-w-4xl mx-auto">
      <!-- Introduction -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold mb-6 pb-3 border-b border-gray-200 dark:border-gray-800 flex items-center gap-2">
          <i class="fas fa-users"></i> Community Introduction
        </h2>
        <blockquote class="border-l-4 border-brand-600 pl-6 my-6 text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
          <p class="mb-4">
            Open Platform Developer Community (OPDC) strives to improve the quality and productivity<br/>
            of open platforms and related services, while supporting developers to learn and grow together<br/>
            through various exchanges and initiatives. We aim to create a more open technology ecosystem<br/>
            through open source development and distribution.
          </p>
          <p class="font-bold text-brand-600 dark:text-brand-500">
            An open community where developers learn and grow together, Open Platform Developer Community.
          </p>
        </blockquote>
      </section>

      <!-- Main Business -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold mb-6 pb-3 border-b border-gray-200 dark:border-gray-800 flex items-center gap-2">
          <i class="fas fa-lightbulb"></i> Main Activities
        </h2>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <span class="text-brand-600 mt-1">•</span>
            <span class="text-gray-700 dark:text-gray-300">Development and advancement of open platforms</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-600 mt-1">•</span>
            <span class="text-gray-700 dark:text-gray-300">Education and domestic/international distribution of open platforms</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-600 mt-1">•</span>
            <span class="text-gray-700 dark:text-gray-300">Activation of software and services related to open platforms</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-600 mt-1">•</span>
            <span class="text-gray-700 dark:text-gray-300">Strengthening mutual exchanges and bonds among developers</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-600 mt-1">•</span>
            <span class="text-gray-700 dark:text-gray-300">Other activities necessary to achieve our organization's objectives</span>
          </li>
        </ul>
      </section>

      <!-- Organization Chart -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold mb-6 pb-3 border-b border-gray-200 dark:border-gray-800 flex items-center gap-2">
          <i class="fas fa-sitemap"></i> Organization Chart
        </h2>
        <div class="bg-gray-50 dark:bg-gray-800 p-4 rounded-lg">
          <img src="/img/about/organization.png" alt="OPDC Organization Chart" class="w-full h-auto rounded" />
        </div>
      </section>

      <!-- Contact -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold mb-6 pb-3 border-b border-gray-200 dark:border-gray-800 flex items-center gap-2">
          <i class="fas fa-envelope"></i> Contact Us
        </h2>
        <div class="space-y-3">
          <p class="text-gray-700 dark:text-gray-300">
            <span class="font-medium">Email:</span> <a href="mailto:opdc.kr@gmail.com" class="text-brand-600 hover:underline">opdc.kr@gmail.com</a>
          </p>
          <p class="text-gray-700 dark:text-gray-300">
            <span class="font-medium">Phone:</span> +82-70-4448-2673
          </p>
        </div>
      </section>

      <!-- Location -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold mb-6 pb-3 border-b border-gray-200 dark:border-gray-800 flex items-center gap-2">
          <i class="fas fa-map-marker-alt"></i> Location
        </h2>
        <p class="text-gray-700 dark:text-gray-300">
          <span class="font-medium">Address:</span> 7F, Seoul Chamber of Commerce & Industry,<br/>
          <span class="ml-20">39 Sejong-daero, Jung-gu, Seoul, 04513, Korea</span><br/>
          <span class="ml-20">Open Cloud Platform Center, OPDC Secretariat</span>
        </p>
      </section>

      <!-- Bylaws -->
      <section class="bg-gray-50 dark:bg-gray-800 rounded-lg p-8">
        <h2 class="text-3xl font-bold mb-6 flex items-center gap-2">
          <i class="fas fa-file-alt"></i> Bylaws
        </h2>
        <a
          href="/pdf/bylaws_20220218_modified.pdf"
          target="_blank"
          class="inline-flex items-center gap-2 text-brand-600 hover:text-brand-700 dark:text-brand-500 dark:hover:text-brand-400 font-medium"
        >
          <i class="fas fa-download"></i>
          OPDC Bylaws (Revised as of Feb 18, 2022)
        </a>
      </section>
    </div>
  </div>
</BaseLayout>
