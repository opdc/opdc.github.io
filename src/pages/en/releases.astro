---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const releases = await getCollection('releases', ({ data }) => data.locale === 'en')
// Sort by version descending (latest first)
releases.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<BaseLayout title="Release Notes" description="OPDC Website Change History">
  <div class="bg-gradient-to-br from-brand-50 to-blue-50 dark:from-gray-800 dark:to-gray-900 py-12">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Release Notes</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        Check the change history of OPDC website
      </p>
    </div>
  </div>

  <div class="container mx-auto px-4 py-12">
    <div class="max-w-3xl mx-auto">
      {releases.map(async (release) => {
        const { Content } = await release.render()
        return (
          <article class="mb-12 pb-12 border-b border-gray-200 dark:border-gray-700 last:border-0">
            <div class="flex items-center gap-4 mb-4">
              <span class="px-3 py-1 bg-brand-600 text-white text-sm font-bold rounded-full">
                v{release.data.version}
              </span>
              <time class="text-sm text-gray-500 dark:text-gray-400">
                {release.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </div>
            <h2 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">
              {release.data.title}
            </h2>
            <div class="prose dark:prose-invert max-w-none">
              <Content />
            </div>
          </article>
        )
      })}
    </div>
  </div>
</BaseLayout>
