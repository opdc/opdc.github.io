---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import BlogTabsEn from '@/components/blog/BlogTabsEn.astro'

const allVideos = await getCollection('videos')
const videos = allVideos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

// URL parameter filtering
const url = new URL(Astro.request.url)
const filter = url.searchParams.get('filter') || 'all'

const filteredVideos = filter === 'all'
  ? videos
  : videos.filter(v => v.data.type === filter)

const videoCount = videos.filter(v => v.data.type === 'video').length
const shortsCount = videos.filter(v => v.data.type === 'shorts').length
const playlistCount = videos.filter(v => v.data.type === 'playlist').length
---

<BaseLayout title="Videos" description="Check out OPDC's YouTube videos">
  <div class="bg-gradient-to-br from-brand-50 to-blue-50 dark:from-gray-800 dark:to-gray-900 py-12">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">News & Announcements</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        Check out the latest news and announcements from OPDC
      </p>
    </div>
  </div>

  <div class="container mx-auto px-4 py-12">
    <div class="max-w-6xl mx-auto">
      <BlogTabsEn activeTab="videos" />

      <!-- Video type filter -->
      <div class="flex gap-2 mb-8">
        <a
          href="/en/blog/videos"
          class:list={[
            'px-4 py-2 rounded-full text-sm font-medium transition-colors',
            filter === 'all'
              ? 'bg-brand-600 text-white'
              : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700'
          ]}
        >
          All ({videos.length})
        </a>
        <a
          href="/en/blog/videos?filter=video"
          class:list={[
            'px-4 py-2 rounded-full text-sm font-medium transition-colors',
            filter === 'video'
              ? 'bg-brand-600 text-white'
              : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700'
          ]}
        >
          Videos ({videoCount})
        </a>
        <a
          href="/en/blog/videos?filter=shorts"
          class:list={[
            'px-4 py-2 rounded-full text-sm font-medium transition-colors',
            filter === 'shorts'
              ? 'bg-brand-600 text-white'
              : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700'
          ]}
        >
          Shorts ({shortsCount})
        </a>
        <a
          href="/en/blog/videos?filter=playlist"
          class:list={[
            'px-4 py-2 rounded-full text-sm font-medium transition-colors',
            filter === 'playlist'
              ? 'bg-brand-600 text-white'
              : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700'
          ]}
        >
          Playlists ({playlistCount})
        </a>
      </div>

      {filteredVideos.length === 0 ? (
        <div class="text-center py-20">
          <p class="text-xl text-gray-600 dark:text-gray-400">
            No videos registered yet.
          </p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {filteredVideos.map((video) => (
            <article class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-shadow">
              <div class:list={[
                'relative w-full',
                video.data.type === 'shorts' ? 'aspect-[9/16] max-h-80' : 'aspect-video'
              ]}>
                <iframe
                  src={video.data.type === 'playlist'
                    ? `https://www.youtube.com/embed/videoseries?list=${video.data.videoId}`
                    : `https://www.youtube.com/embed/${video.data.videoId}`}
                  title={video.data.title}
                  class="absolute inset-0 w-full h-full"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              </div>
              <div class="p-4">
                <div class="flex items-center gap-2 mb-2">
                  <span class:list={[
                    'text-xs px-2 py-1 rounded',
                    video.data.type === 'shorts'
                      ? 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400'
                      : video.data.type === 'playlist'
                        ? 'bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400'
                        : 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400'
                  ]}>
                    {video.data.type === 'shorts' ? 'Shorts' : video.data.type === 'playlist' ? 'Playlist' : 'Video'}
                  </span>
                  <time class="text-xs text-gray-500 dark:text-gray-400">
                    {video.data.date.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </time>
                </div>
                <h3 class="font-bold text-gray-900 dark:text-white line-clamp-2">
                  {video.data.title}
                </h3>
                {video.data.description && (
                  <p class="text-sm text-gray-600 dark:text-gray-400 mt-2 line-clamp-2">
                    {video.data.description}
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
