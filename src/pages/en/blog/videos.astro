---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import BlogTabsEn from '@/components/blog/BlogTabsEn.astro'
import VideoFilter from '@/components/VideoFilter'

const allVideos = await getCollection('videos')
const videos = allVideos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

// Transform videos for the React component
const videosData = videos.map(v => ({
  slug: v.slug,
  title: v.data.title,
  videoId: v.data.videoId,
  date: v.data.date.toISOString(),
  description: v.data.description,
  type: v.data.type,
}))
---

<BaseLayout title="Videos" description="Check out OPDC's YouTube videos">
  <div class="bg-gradient-to-br from-brand-50 to-blue-50 dark:from-gray-800 dark:to-gray-900 py-12">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">News & Announcements</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        Check out the latest news and announcements from OPDC
      </p>
    </div>
  </div>

  <div class="container mx-auto px-4 py-12">
    <div class="max-w-6xl mx-auto">
      <BlogTabsEn activeTab="videos" />
      <VideoFilter client:load videos={videosData} locale="en" />
    </div>
  </div>
</BaseLayout>
