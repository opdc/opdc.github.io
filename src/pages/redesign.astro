---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero16 from '@/components/hero/Hero16.astro'
import '@/styles/redesign-2026.css'

const projects = [
  { name: 'eGovFrame Compatibility', label: 'Compatibility', description: '전자정부 표준프레임워크 기반 생태계의 호환성과 검증을 지원합니다.', href: '/projects' },
  { name: 'Open Platform Projects', label: 'Open Source', description: '커뮤니티가 함께 만들고 유지하는 오픈플랫폼 프로젝트를 모아봅니다.', href: '/projects' },
  { name: 'Community Knowledge', label: 'Knowledge', description: '개발 경험과 기술 자료를 공유하고 다음 기여자를 연결합니다.', href: '/blog' },
]

const activities = [
  { type: 'EVENT', title: '오픈커뮤니티 행사와 세미나', meta: 'Community / Event', href: '/community' },
  { type: 'NEWS', title: '새로운 프로젝트와 기술 소식', meta: 'News / Project', href: '/blog' },
  { type: 'VIDEO', title: '발표와 기술 공유 콘텐츠', meta: 'Video / Knowledge', href: '/blog' },
]
---

<BaseLayout title="2026 Community Redesign Preview" description="OPDC 2026 커뮤니티 중심 리뉴얼 미리보기">
  <Hero16 />

  <section class="opdc-section bg-gray-50 dark:bg-gray-900/70">
    <div class="opdc-container">
      <div class="mb-10 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="opdc-eyebrow">Community Pulse</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-950 sm:text-4xl dark:text-white">지금 커뮤니티에서 일어나는 일</h2>
        </div>
        <a href="/blog" class="text-sm font-semibold text-brand-700 hover:text-brand-800 dark:text-brand-400">모든 활동 보기 →</a>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        {activities.map((item) => (
          <a href={item.href} class="opdc-panel opdc-signal group p-6 transition hover:-translate-y-1 hover:shadow-xl">
            <div class="relative z-10">
              <p class="text-xs font-bold tracking-[0.16em] text-brand-700 dark:text-brand-400">{item.type}</p>
              <h3 class="mt-8 text-xl font-bold text-gray-950 dark:text-white">{item.title}</h3>
              <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">{item.meta}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="opdc-section bg-white dark:bg-gray-950">
    <div class="opdc-container">
      <div class="mb-10 flex items-end justify-between gap-6">
        <div>
          <p class="opdc-eyebrow">Projects</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-950 sm:text-4xl dark:text-white">프로젝트를 발견하고 연결합니다</h2>
        </div>
        <a href="/projects" class="hidden text-sm font-semibold text-brand-700 hover:text-brand-800 sm:block dark:text-brand-400">프로젝트 전체 보기 →</a>
      </div>

      <div class="grid gap-5 lg:grid-cols-3">
        {projects.map((project) => (
          <article class="group rounded-2xl border border-gray-200 bg-white p-7 transition hover:border-brand-300 hover:shadow-xl dark:border-gray-800 dark:bg-gray-900">
            <span class="inline-flex rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700 dark:bg-brand-950/50 dark:text-brand-300">{project.label}</span>
            <h3 class="mt-8 text-2xl font-bold text-gray-950 dark:text-white">{project.name}</h3>
            <p class="mt-4 leading-7 text-gray-600 dark:text-gray-300">{project.description}</p>
            <a href={project.href} class="mt-8 inline-flex font-semibold text-gray-900 group-hover:text-brand-700 dark:text-white dark:group-hover:text-brand-400">자세히 보기 →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="opdc-section bg-gray-950 text-white">
    <div class="opdc-container grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-orange-400">Why OPDC</p>
        <h2 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">Open Platform.<br />Open Source.<br />Open Community.</h2>
      </div>
      <div class="grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-3">
        {[
          ['01', 'Open Platform', '플랫폼과 생태계를 연결합니다.'],
          ['02', 'Open Source', '함께 만들고 재사용할 수 있게 합니다.'],
          ['03', 'Open Community', '사람과 지식을 다음 기여자로 연결합니다.'],
        ].map(([number, title, text]) => (
          <div class="bg-gray-950 p-7">
            <p class="text-xs font-bold tracking-[0.16em] text-orange-400">{number}</p>
            <h3 class="mt-10 text-xl font-bold">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-gray-400">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="opdc-section bg-white dark:bg-gray-950">
    <div class="opdc-container">
      <div class="opdc-panel grid gap-8 p-8 sm:p-10 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <p class="opdc-eyebrow">Join OPDC</p>
          <h2 class="mt-3 text-3xl font-bold text-gray-950 dark:text-white">다음 프로젝트의 첫 번째 기여자가 되어보세요.</h2>
          <p class="mt-4 max-w-2xl text-gray-600 dark:text-gray-300">프로젝트를 사용하고, 행사에 참여하고, 기술을 공유하고, 새로운 아이디어를 제안할 수 있습니다.</p>
        </div>
        <a href="/community" class="inline-flex items-center justify-center rounded-xl bg-brand-700 px-6 py-3.5 font-semibold text-white hover:bg-brand-800">커뮤니티 참여 →</a>
      </div>
    </div>
  </section>
</BaseLayout>
