---
import '@/redesign/pages.css'
interface Props { title?: string; description?: string }
const { title = 'OPDC — Open Platform Developer Community', description = '기술을 공유하고, 함께 만들고, 오픈 플랫폼 생태계를 연결하는 개발자 커뮤니티' } = Astro.props
const path = Astro.url.pathname
const nav = [
  ['About','/redesign/about/'],
  ['Projects','/redesign/projects/'],
  ['Community','/redesign/community/'],
  ['People','/redesign/leaders/'],
  ['Blog','/redesign/blog/']
]
const utility = [
  ['History','/redesign/history/'],
  ['Partners','/redesign/partners/'],
  ['Releases','/redesign/releases/'],
  ['Compatibility','/redesign/compatibility/']
]
const isActive = (href:string) => href === '/redesign/' ? path === href : path.startsWith(href)
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#faf8f3" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css" />
  <title>{title}</title>
</head>
<body class="opdc-redesign-shell">
  <a class="redesign-skip" href="#content">본문으로 건너뛰기</a>
  <header class="redesign-header">
    <div class="redesign-container redesign-header-inner">
      <a class="redesign-wordmark" href="/redesign/" aria-label="OPDC 리뉴얼 홈">OPDC<span>OPEN PLATFORM DEVELOPER COMMUNITY</span></a>
      <nav class="redesign-nav" aria-label="주요 메뉴">
        {nav.map(([label,href]) => <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
      <a class="redesign-github" href="https://github.com/opdc" target="_blank" rel="noreferrer">GitHub ↗</a>
      <button class="redesign-menu" type="button" aria-expanded="false" aria-controls="redesign-mobile-nav"><span>MENU</span><i aria-hidden="true"></i></button>
    </div>
    <div id="redesign-mobile-nav" class="redesign-mobile-nav" hidden>
      <div class="redesign-container redesign-mobile-nav-inner">
        <nav aria-label="모바일 주요 메뉴">{nav.map(([label,href]) => <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}<span>→</span></a>)}</nav>
        <div class="redesign-mobile-utility">{utility.map(([label,href]) => <a href={href}>{label}</a>)}<a href="https://github.com/opdc" target="_blank" rel="noreferrer">GitHub ↗</a><a href="/">기존 사이트</a></div>
      </div>
    </div>
  </header>
  <main id="content"><slot /></main>
  <footer class="redesign-footer">
    <div class="redesign-container redesign-footer-grid">
      <div class="redesign-footer-brand"><strong>OPDC</strong><p>기술을 공유하고, 함께 만들고,<br/>오픈 플랫폼 생태계를 연결합니다.</p></div>
      <div class="redesign-footer-col"><b>EXPLORE</b>{nav.map(([label,href]) => <a href={href}>{label}</a>)}</div>
      <div class="redesign-footer-col"><b>MORE</b>{utility.map(([label,href]) => <a href={href}>{label}</a>)}</div>
      <div class="redesign-footer-col"><b>CONNECT</b><a href="https://github.com/opdc" target="_blank" rel="noreferrer">GitHub ↗</a><a href="mailto:opdc.kr@gmail.com">Email ↗</a><a href="/">기존 사이트</a></div>
    </div>
    <div class="redesign-container redesign-footer-bottom"><span>© OPDC. Open Platform Developer Community.</span><a href="/redesign/">Back to redesign home ↑</a></div>
  </footer>
  <script>
    const button=document.querySelector('.redesign-menu');
    const mobile=document.querySelector('#redesign-mobile-nav');
    const close=()=>{button?.setAttribute('aria-expanded','false');if(mobile) mobile.hidden=true};
    button?.addEventListener('click',()=>{const expanded=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!expanded));if(mobile) mobile.hidden=expanded});
    mobile?.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));
    window.addEventListener('resize',()=>{if(window.innerWidth>900) close()});
  </script>
</body>
</html>