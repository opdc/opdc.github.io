---
import '@/redesign/pages.css'
import '@/redesign/final.css'
import '@/redesign/color-system-v4.css'
import '@/redesign/design-system-v5.css'
interface Props { title?: string; description?: string; image?: string }
const {title='OPDC — Open Platform Developer Community',description='개발자가 경험을 공개 자산으로 만들고 사람과 프로젝트를 연결하는 오픈플랫폼 개발자 커뮤니티',image='/img/about/opdc_img.webp'}=Astro.props
const path=Astro.url.pathname
const canonical=new URL(path,Astro.site??Astro.url.origin).toString()
const ogImage=new URL(image,Astro.site??Astro.url.origin).toString()
const nav=[['About','/redesign/about/'],['Projects','/redesign/projects/'],['Community','/redesign/community/'],['People','/redesign/leaders/'],['Blog','/redesign/blog/']]
const utility=[['History','/redesign/history/'],['Partners','/redesign/partners/'],['Releases','/redesign/releases/'],['Compatibility','/redesign/compatibility/']]
const isActive=(href:string)=>href==='/redesign/'?path===href:path.startsWith(href)
const organizationJson=JSON.stringify({'@context':'https://schema.org','@type':'Organization',name:'Open Platform Developer Community',alternateName:'OPDC',url:new URL('/redesign/',Astro.site??Astro.url.origin).toString(),email:'opdc.kr@gmail.com',sameAs:['https://github.com/opdc']})
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#f7f8fa"/><meta name="color-scheme" content="light"/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin="anonymous"/><link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css"/><meta property="og:type" content="website"/><meta property="og:site_name" content="OPDC"/><meta property="og:locale" content="ko_KR"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={ogImage}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImage}/><script type="application/ld+json" set:html={organizationJson}></script><title>{title}</title></head><body class="opdc-redesign-shell"><a class="redesign-skip" href="#content">본문으로 건너뛰기</a><header class="redesign-header"><div class="redesign-container redesign-header-inner"><a class="redesign-wordmark" href="/redesign/" aria-label="OPDC 리뉴얼 홈">OPDC<span>OPEN PLATFORM DEVELOPER COMMUNITY</span></a><nav class="redesign-nav" aria-label="주요 메뉴">{nav.map(([label,href])=><a href={href} aria-current={isActive(href)?'page':undefined}>{label}</a>)}</nav><a class="redesign-github" href="https://github.com/opdc" target="_blank" rel="noopener noreferrer">GitHub ↗</a><button class="redesign-menu" type="button" aria-expanded="false" aria-controls="redesign-mobile-nav" aria-label="메뉴 열기"><span>MENU</span><i aria-hidden="true"></i></button></div><div id="redesign-mobile-nav" class="redesign-mobile-nav" hidden><div class="redesign-container redesign-mobile-nav-inner"><nav aria-label="모바일 주요 메뉴">{nav.map(([label,href])=><a href={href} aria-current={isActive(href)?'page':undefined}>{label}<span aria-hidden="true">→</span></a>)}</nav><div class="redesign-mobile-utility">{utility.map(([label,href])=><a href={href} aria-current={isActive(href)?'page':undefined}>{label}</a>)}<a href="https://github.com/opdc" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="/">기존 사이트</a></div></div></div></header><main id="content" tabindex="-1"><slot/></main><footer class="redesign-footer"><div class="redesign-container redesign-footer-grid"><div class="redesign-footer-brand"><strong>OPDC</strong><p>BUILD · SHARE · CONNECT · GROW<br/>경험을 공개 자산으로 연결합니다.</p></div><div class="redesign-footer-col"><b>EXPLORE</b>{nav.map(([label,href])=><a href={href}>{label}</a>)}</div><div class="redesign-footer-col"><b>ARCHIVE</b>{utility.map(([label,href])=><a href={href}>{label}</a>)}</div><div class="redesign-footer-col"><b>CONNECT</b><a href="https://github.com/opdc" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="mailto:opdc.kr@gmail.com">Email ↗</a><a href="/">기존 사이트</a></div></div><div class="redesign-container redesign-footer-bottom"><span>© OPDC · Open Platform Developer Community</span><a href="#content">Back to top ↑</a></div></footer><script>
const button=document.querySelector<HTMLButtonElement>('.redesign-menu');const mobile=document.querySelector<HTMLElement>('#redesign-mobile-nav');const focusables=()=>mobile?Array.from(mobile.querySelectorAll<HTMLElement>('a,button,[tabindex]:not([tabindex="-1"])')):[];const close=(restore=false)=>{button?.setAttribute('aria-expanded','false');button?.setAttribute('aria-label','메뉴 열기');document.body.classList.remove('redesign-menu-open');if(mobile)mobile.hidden=true;if(restore)button?.focus()};const open=()=>{button?.setAttribute('aria-expanded','true');button?.setAttribute('aria-label','메뉴 닫기');document.body.classList.add('redesign-menu-open');if(mobile)mobile.hidden=false;requestAnimationFrame(()=>focusables()[0]?.focus())};button?.addEventListener('click',()=>button.getAttribute('aria-expanded')==='true'?close(true):open());mobile?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>close(false)));window.addEventListener('resize',()=>{if(window.innerWidth>900)close(false)});window.addEventListener('keydown',event=>{if(event.key==='Escape'&&button?.getAttribute('aria-expanded')==='true'){event.preventDefault();close(true);return}if(event.key!=='Tab'||button?.getAttribute('aria-expanded')!=='true')return;const items=focusables();if(!items.length)return;const first=items[0],last=items[items.length-1];if(event.shiftKey&&document.activeElement===first){event.preventDefault();button?.focus()}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();button?.focus()}else if(event.shiftKey&&document.activeElement===button){event.preventDefault();last.focus()}else if(!event.shiftKey&&document.activeElement===button){event.preventDefault();first.focus()}})
</script></body></html>